{
  "manifest_version": 3,
  "name": "MinGE — Minimal New Tab",
  "version": "1.0.0",
  "description": "A minimalistic new tab page with todos, shortcuts, and weather.",
  "chrome_url_overrides": {
    "newtab": "newtab.html"
  },
  "permissions": ["storage", "geolocation", "identity"],
  "host_permissions": [
    "https://geocoding-api.open-meteo.com/*",
    "https://api.open-meteo.com/*",
    "https://ipwho.is/*",
    "https://fonts.googleapis.com/*",
    "https://fonts.gstatic.com/*"
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "oauth2": {
    "client_id": "273925845959-857jq38on2fsmknmshen8e509i9ramfp.apps.googleusercontent.com",
    "scopes": [
      "openid",
      "email",
      "profile"
    ]
  }
}
